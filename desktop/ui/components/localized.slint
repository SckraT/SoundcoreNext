// Translations for the names and values that come from the device model rather
// than from static Slint text. Keeping them here means the UI can localize a
// setting row without changing the protocol ids or the Rust model.
export global LocalizedText {
    public pure function setting-label(id: string, fallback: string) -> string {
        if id == "singlePress" { return @tr("Single press"); }
        if id == "doublePress" { return @tr("Double press"); }
        if id == "sideTone" { return @tr("Side tone"); }
        if id == "limitHighVolume" { return @tr("Limit high volume"); }
        if id == "limitHighVolumeDbLimit" { return @tr("dB limit"); }
        if id == "limitHighVolumeRefreshRate" { return @tr("Refresh rate"); }
        if id == "autoPowerOff" { return @tr("Auto power off"); }
        if id == "lowBatteryPrompt" { return @tr("Low battery prompt"); }
        if id == "voicePrompt" { return @tr("Voice prompt"); }
        if id == "dualConnections" { return @tr("Dual connections"); }
        if id == "ldac" { return @tr("LDAC"); }
        if id == "dolbyAudio" { return @tr("Dolby audio"); }
        if id == "dualDevices" { return @tr("Paired devices"); }
        if id == "isCharging" { return @tr("Is charging"); }
        if id == "batteryLevel" { return @tr("Battery level"); }
        if id == "firmwareVersion" { return @tr("Firmware version"); }
        if id == "windNoiseSuppression" { return @tr("Wind noise suppression"); }
        if id == "wearingDetection" { return @tr("Wearing detection"); }
        if id == "easyChat" { return @tr("Easy chat"); }
        if id == "easyChatWaitTime" { return @tr("Easy chat wait time"); }
        if id == "soundLeakCompensation" { return @tr("Sound leak compensation"); }
        if id == "spatialAudio" { return @tr("Spatial audio"); }
        if id == "spatialAudioMusicMode" { return @tr("Spatial audio music mode"); }
        if id == "spatialAudioMode" { return @tr("Spatial audio mode"); }
        // The A3954's twelve measured gestures. The Controls page shows both
        // earbuds, so each row names its side.
        if id == "leftSinglePress" { return @tr("Left single press"); }
        if id == "rightSinglePress" { return @tr("Right single press"); }
        if id == "leftDoublePress" { return @tr("Left double press"); }
        if id == "rightDoublePress" { return @tr("Right double press"); }
        if id == "leftTriplePress" { return @tr("Left triple press"); }
        if id == "rightTriplePress" { return @tr("Right triple press"); }
        if id == "leftLongPress" { return @tr("Left long press"); }
        if id == "rightLongPress" { return @tr("Right long press"); }
        if id == "leftSlideUp" { return @tr("Left slide up"); }
        if id == "rightSlideUp" { return @tr("Right slide up"); }
        if id == "leftSlideDown" { return @tr("Left slide down"); }
        if id == "rightSlideDown" { return @tr("Right slide down"); }
        // The A3954 case page: the four case-screen features and the language.
        if id == "atmospheric" { return @tr("Atmospheric"); }
        if id == "remoteCamera" { return @tr("Remote camera"); }
        if id == "findDevice" { return @tr("Find device"); }
        if id == "caseSpatialAudio" { return @tr("Spatial audio on case"); }
        if id == "caseLanguage" { return @tr("Case language"); }
        if id == "leftBattery" { return @tr("Left battery"); }
        if id == "rightBattery" { return @tr("Right battery"); }
        if id == "caseBattery" { return @tr("Case battery"); }
        if id == "leftFirmware" { return @tr("Left firmware"); }
        if id == "rightFirmware" { return @tr("Right firmware"); }
        if id == "caseFirmware" { return @tr("Case firmware"); }
        return fallback;
    }

    public pure function setting-text(id: string, fallback: string) -> string {
        if id == "singlePress" { return @tr("Ambient sound mode"); }
        if id == "isCharging" {
            return fallback == "Charging" ? @tr("Charging") : @tr("Not charging");
        }
        return fallback;
    }

    public pure function option(value: string) -> string {
        if value == "None" { return @tr("None"); }
        if value == "Bass Up" { return @tr("Bass up"); }
        if value == "Disabled" { return @tr("Disabled"); }
        if value == "5 seconds" { return @tr("5 seconds"); }
        if value == "10 seconds" { return @tr("10 seconds"); }
        if value == "15 seconds" { return @tr("15 seconds"); }
        if value == "10 minutes" { return @tr("10 minutes"); }
        if value == "20 minutes" { return @tr("20 minutes"); }
        if value == "30 minutes" { return @tr("30 minutes"); }
        if value == "60 minutes" { return @tr("60 minutes"); }
        if value == "90 minutes" { return @tr("90 minutes"); }
        if value == "120 minutes" { return @tr("120 minutes"); }
        if value == "Real time" { return @tr("Real time"); }
        if value == "1 minute" { return @tr("1 minute"); }
        if value == "Fixed" { return @tr("Fixed"); }
        if value == "Head tracking" { return @tr("Head tracking"); }
        if value == "Music" { return @tr("Music"); }
        if value == "Podcast" { return @tr("Podcast"); }
        if value == "Movie" { return @tr("Movie"); }
        if value == "Gaming" { return @tr("Gaming"); }
        // The A3954 gesture actions and case-display languages.
        if value == "Volume up" { return @tr("Volume up"); }
        if value == "Volume down" { return @tr("Volume down"); }
        if value == "Previous song" { return @tr("Previous song"); }
        if value == "Next song" { return @tr("Next song"); }
        if value == "Ambient sound mode" { return @tr("Ambient sound mode"); }
        if value == "Voice assistant" { return @tr("Voice assistant"); }
        if value == "Play/pause" { return @tr("Play/pause"); }
        if value == "Japanese" { return @tr("Japanese"); }
        if value == "English" { return @tr("English"); }
        if value == "Chinese" { return @tr("Chinese"); }
        if value == "Unknown device" { return @tr("Unknown device"); }
        if value == "Noise canceling" { return @tr("Noise canceling"); }
        if value == "Transparency" { return @tr("Transparency"); }
        if value == "Normal" { return @tr("Normal"); }
        return value;
    }

    public pure function mode-label(value: string, fallback: string) -> string {
        if value == "NoiseCanceling" { return @tr("Noise canceling"); }
        if value == "Transparency" { return @tr("Transparency"); }
        if value == "Normal" { return @tr("Normal"); }
        if value == "AirplaneMode" { return @tr("Airplane mode"); }
        return fallback;
    }
}
