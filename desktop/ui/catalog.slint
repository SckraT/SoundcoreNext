import { ScrollView } from "std-widgets.slint";

export struct CatalogModel {
    code: string,
    name: string,
    battery: string,
    confidence: string,
}

export struct CatalogFamily {
    title: string,
    tier: string,
    models: [CatalogModel],
}

export struct CatalogForm {
    title: string,
    subtitle: string,
    families: [CatalogFamily],
}

export component MainWindow inherits Window {
    title: "Soundcore Next — каталог моделей";
    width: 1180px;
    height: 780px;
    background: #f5efea;

    in property <[CatalogForm]> forms: [];
    in-out property <string> detail: "Выберите модель слева";
    callback select(string);

    VerticalLayout {
        padding: 24px;
        spacing: 14px;

        Text {
            text: "Каталог моделей";
            font-size: 26px;
            font-weight: 700;
            color: #251f2b;
        }
        Text {
            text: "Форм-фактор → семейство → модель. Признаки семейства — навигация, а не обещание настроек.";
            font-size: 13px;
            color: #716776;
        }

        HorizontalLayout {
            spacing: 16px;
            height: 100%;

            ScrollView {
                width: 62%;
                VerticalLayout {
                    spacing: 18px;
                    for form in forms: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: form.title;
                            font-size: 18px;
                            font-weight: 700;
                            color: #6c4fb3;
                        }
                        Text {
                            text: form.subtitle;
                            font-size: 11px;
                            color: #716776;
                        }
                        for family in form.families: Rectangle {
                            background: #ffffff;
                            border-radius: 16px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                HorizontalLayout {
                                    Text {
                                        text: family.title;
                                        font-size: 14px;
                                        font-weight: 650;
                                        color: #251f2b;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: family.tier;
                                        font-size: 11px;
                                        color: #716776;
                                    }
                                }
                                for model in family.models: Rectangle {
                                    background: #efe7e2;
                                    border-radius: 10px;
                                    height: 38px;
                                    TouchArea {
                                        clicked => { root.select(model.code); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        Text {
                                            text: model.code;
                                            font-size: 11px;
                                            color: #716776;
                                            width: 52px;
                                        }
                                        Text {
                                            text: model.name;
                                            font-size: 13px;
                                            color: #251f2b;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: model.battery;
                                            font-size: 10px;
                                            color: #716776;
                                        }
                                        Text {
                                            text: model.confidence;
                                            font-size: 10px;
                                            color: #b06a2c;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 38%;
                background: #ffffff;
                border-radius: 20px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "О модели";
                        font-size: 16px;
                        font-weight: 700;
                        color: #251f2b;
                    }
                    Text {
                        text: root.detail;
                        font-size: 13px;
                        color: #251f2b;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                        vertical-alignment: top;
                    }
                    Text {
                        text: "Данные: wiki/protocol/model-taxonomy.md";
                        font-size: 10px;
                        color: #716776;
                    }
                }
            }
        }
    }
}
